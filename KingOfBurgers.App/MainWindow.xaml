<Window x:Class="KingOfBurgers.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KingOfBurgers.App.Views"
        Title="King of Burgers"
        Width="1024"
        Height="700"
        MinWidth="800"
        MinHeight="560"
        Background="#1E1B20">

    <Window.DataContext>
        <views:PreviewGameViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Встроенный в WPF конвертер: превращает true в Visible, а false в Collapsed -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" /> <!-- временно?? -->
    </Window.Resources>

    <Grid Margin="16">
        <!-- ЭКРАН МЕНЮ -->
        <Border Visibility="{Binding IsMenuVisible, Converter={StaticResource BoolToVis}}"
                Background="#2B2529"
                CornerRadius="12"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="440">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="KING OF BURGERS"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#D24D24"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="Поочередное приготовление бургера на двоих"
                           FontSize="14"
                           Foreground="#D6C7B2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28" />
                <Button Content="Новая игра"
                        Command="{Binding StartGameCommand}"
                        Padding="24,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- ИГРОВОЙ ЭКРАН -->
        <Grid Visibility="{Binding IsGameVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Верхняя панель: раунд, ход и счёт обоих игроков -->
            <Border Grid.Row="0"
                    Background="#2D2D30"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Игрок 1 -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock Text="Игрок 1"
                                   FontSize="13"
                                   Foreground="#D6C7B2" />
                        <TextBlock Text="{Binding PlayerOneScore, StringFormat='Очки: {0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FF0000" />
                    </StackPanel>

                    <!-- Центр: раунд и индикатор текущего хода -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="24,0">
                        <TextBlock Text="{Binding RoundNumber, StringFormat='Раунд {0}'}"
                                   FontSize="13"
                                   Foreground="#D6C7B2"
                                   HorizontalAlignment="Center" />
                        <Border Background="#3D345D"
                                CornerRadius="6"
                                Padding="14,4"
                                Margin="0,4,0,0">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Игрок 2 -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Игрок 2"
                                   FontSize="13"
                                   Foreground="#D6C7B2"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PlayerTwoScore, StringFormat='Очки: {0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FF0000"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Рабочая зона: два слота под бургеры рядом -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Слот Игрока 1 -->
                <Border Grid.Column="0"
                        Background="#2D2D30"
                        CornerRadius="10"
                        BorderBrush="#4A3F35"
                        BorderThickness="2"
                        Padding="12">
                    <TextBlock Text="Зона бургера — Игрок 1"
                               Foreground="#9C8B7A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top" />
                </Border>

                <!-- Слот Игрока 2 -->
                <Border Grid.Column="2"
                        Background="#2D2D30"
                        CornerRadius="10"
                        BorderBrush="#4D3D30"
                        BorderThickness="2"
                        Padding="12">
                    <TextBlock Text="Зона бургера — Игрок 2"
                               Foreground="#9C8B7A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top" />
                </Border>
            </Grid>
        </Grid>

        <!-- ЭКРАН ПОБЕДЫ -->
        <Border Visibility="{Binding IsVictoryVisible, Converter={StaticResource BoolToVis}}"
                Background="#2B2529"
                CornerRadius="12"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="440">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding WinnerText}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#D24D24"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding PlayerOneScore, StringFormat='Игрок 1: {0} очков'}"
                           FontSize="16"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding PlayerTwoScore, StringFormat='Игрок 2: {0} очков'}"
                           FontSize="16"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Реванш"
                            Command="{Binding RestartCommand}"
                            Padding="18,10"
                            FontSize="15"
                            Margin="0,0,12,0"
                            Cursor="Hand" />
                    <Button Content="В меню"
                            Command="{Binding BackToMenuCommand}"
                            Padding="18,10"
                            FontSize="15"
                            Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>